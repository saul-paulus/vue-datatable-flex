{
  "name": "vue-datatables-flex",
  "version": "1.0.0",
  "description": "A flexible, responsive DataTable component for Vue 3 and Nuxt, built on top of DataTables.net",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "datatable",
    "datatables",
    "table",
    "responsive",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "./dist/vue-datatables-flex.cjs.js",
  "module": "./dist/vue-datatables-flex.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-datatables-flex.es.js",
      "require": "./dist/vue-datatables-flex.cjs.js"
    },
    "./nuxt": {
      "types": "./dist/types/nuxt.d.ts",
      "import": "./dist/nuxt.es.js",
      "require": "./dist/nuxt.cjs.js"
    },
    "./style.css": "./dist/vue-datatables-flex.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build:lib",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "peerDependencies": {
    "datatables.net-vue3": "^3.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "datatables.net-bs5": "^2.3.7",
    "datatables.net-dt": "^2.3.7",
    "datatables.net-responsive": "^3.0.8",
    "datatables.net-responsive-bs5": "^3.0.8",
    "datatables.net-select": "^3.1.3",
    "datatables.net-select-bs5": "^3.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/eslint-plugin": "^1.6.10",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "datatables.net-vue3": "^3.0.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.51.0",
    "eslint-plugin-playwright": "^2.9.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.37.0",
    "oxlint": "~1.51.0",
    "typescript": "~5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitest": "^4.0.18",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
