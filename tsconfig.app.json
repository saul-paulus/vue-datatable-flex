{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.ts",
    "src/**/*",
    "src/**/*.vue",
    "vite.lib.config.ts"
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/nuxt.ts"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "types": ["datatables.net", "jquery"],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}